ARG BASE_IMAGE=127.0.0.1:5000/iran-market-radar/api-base@sha256:795eb3012e2b8a09ddaf83e5aa349975a1011004fac636ffe0afe76daf419d8c
FROM ${BASE_IMAGE}

WORKDIR /app
COPY . .

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

EXPOSE 8742
CMD ["sh", "-c", "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port ${APP_PORT:-8742}"]
