{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublishedSignal",
  "type": "object",
  "required": [
    "id", "instrument_id", "symbol", "as_of", "horizon", "direction",
    "opportunity_score", "p_profit", "confidence", "signal_strength",
    "entry_zone", "invalidation", "exit_plan", "data_quality",
    "strategy_votes", "top_reasons_fa", "risk_flags_fa"
  ],
  "properties": {
    "id": {"type": "string"},
    "instrument_id": {"type": "string"},
    "symbol": {"type": "string"},
    "name_fa": {"type": "string"},
    "market": {"type": "string"},
    "sector": {"type": ["string", "null"]},
    "as_of": {"type": "string", "format": "date-time"},
    "horizon": {"type": "string"},
    "direction": {"enum": ["long"]},
    "actionable": {"type": "boolean"},
    "grade": {"type": "string"},
    "opportunity_score": {"type": "number", "minimum": 0, "maximum": 100},
    "p_profit": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "signal_strength": {"type": "number", "minimum": 0, "maximum": 100},
    "expected_return_pct": {"type": ["number", "null"]},
    "expected_drawdown_pct": {"type": ["number", "null"]},
    "entry_zone": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number"},
        "high": {"type": "number"},
        "max_chase": {"type": ["number", "null"]}
      }
    },
    "invalidation": {
      "type": "object",
      "required": ["reason_fa"],
      "properties": {
        "price": {"type": ["number", "null"]},
        "reason_fa": {"type": "string"},
        "type": {"type": "string"}
      }
    },
    "exit_plan": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "targets": {"type": "array", "items": {"type": "number"}},
        "time_stop_sessions": {"type": ["integer", "null"]},
        "trailing_rule": {"type": ["string", "null"]}
      }
    },
    "liquidity_score": {"type": "number", "minimum": 0, "maximum": 100},
    "fill_probability_score": {"type": "number", "minimum": 0, "maximum": 100},
    "data_quality": {"type": "number", "minimum": 0, "maximum": 100},
    "regime": {"type": "string"},
    "strategy_votes": {"type": "array", "items": {"type": "object"}},
    "top_reasons_fa": {"type": "array", "items": {"type": "string"}},
    "risk_flags_fa": {"type": "array", "items": {"type": "string"}},
    "model_version": {"type": ["string", "null"]},
    "strategy_version": {"type": "string"},
    "calibration_version": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
