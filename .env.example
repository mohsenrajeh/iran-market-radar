# ==============================================================================
# Iran Market Radar — Production Environment Configuration
# ==============================================================================

# Application Ports (Dedicated non-conflicting production ports)
APP_PORT=8742
WEB_PORT=3742
RADAR_POSTGRES_PORT=5742
RADAR_REDIS_PORT=6742

# Environment
APP_ENV=production
LOG_LEVEL=INFO

# Security & Authentication (30-day persistent session)
SESSION_SECRET=radar_institutional_grade_jwt_secret_key_2026_iran_stock_market_secure_7788
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=radar2026

# Paper Trading & Capital (10 Billion Tomans = 100 Billion Rials)
INITIAL_PORTFOLIO_CASH_RIALS=100000000000
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
RISK_KILL_SWITCH_ARMED=true

# Remote Server Deployment Settings (For manage_server.bat)
RADAR_SERVER_IP=193.242.125.76
RADAR_SERVER_PORT=22
RADAR_SERVER_USERNAME=root
RADAR_SERVER_PASSWORD=

# Production Database (Docker Internal & External URLs)
DATABASE_URL=postgresql+asyncpg://radar_user:radar_secure_password_2026@postgres:5432/iran_market_radar
DATABASE_SYNC_URL=postgresql://radar_user:radar_secure_password_2026@postgres:5432/iran_market_radar
