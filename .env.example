# ==============================================================================
# Iran Market Radar — Production Environment Configuration
# ==============================================================================

# Application Ports (Dedicated non-conflicting production ports)
APP_PORT=8742
WEB_PORT=3742
WEB_BIND_HOST=127.0.0.1
RADAR_POSTGRES_PORT=5742
RADAR_REDIS_PORT=6742

# Environment
APP_ENV=production
LOG_LEVEL=INFO

# Security & Authentication (generate unique values; never commit real secrets)
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_MINUTES=43200
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_LONG_PASSWORD
# Local Docker is exposed only on 127.0.0.1 over HTTP. Set true behind HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:3742,http://localhost:3742

# Paper Trading & Capital (10 Billion Tomans = 100 Billion Rials)
INITIAL_PORTFOLIO_CASH_RIALS=100000000000
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
RISK_KILL_SWITCH_ARMED=true
BROKER_ADAPTER=
BROKER_CREDENTIALS=
MARKET_DATA_MODE=official
AUTO_PAPER_TRADING_ENABLED=false
MINIMUM_FUNDAMENTAL_SOURCES=2
# Market data uses the public TSETMC CDN and requires no provider credential.
DATA_HTTP_PROXY=
# False avoids inheriting stale/hostile HTTP_PROXY variables. Set true only when the service environment proxy is intentional.
DATA_HTTP_TRUST_ENV=false

# Remote Server Deployment Settings (For manage_server.bat)
RADAR_SERVER_IP=CHANGE_ME
RADAR_SERVER_PORT=22
RADAR_SERVER_USERNAME=root
RADAR_SERVER_PASSWORD=

# Production Database (Docker Internal & External URLs)
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_RANDOM_REDIS_PASSWORD
DATABASE_URL=postgresql+asyncpg://radar_user:CHANGE_ME@postgres:5432/iran_market_radar
DATABASE_SYNC_URL=postgresql://radar_user:CHANGE_ME@postgres:5432/iran_market_radar
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
